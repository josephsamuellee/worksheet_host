[Unit]
Description=Worksheet Host (Rails)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=worksheet
Group=worksheet
WorkingDirectory=/mnt/raid1/apps/worksheet_host
EnvironmentFile=-/mnt/raid1/apps/worksheet_host/deploy/worksheet_host.env
ExecStart=/mnt/raid1/apps/worksheet_host/bin/rails server -e production
Restart=always
RestartSec=5
KillMode=mixed
TimeoutStopSec=30

# Prefer journald for logs
StandardOutput=journal
StandardError=journal
SyslogIdentifier=worksheet_host

[Install]
WantedBy=multi-user.target
