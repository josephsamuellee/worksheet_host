# Copy to deploy/worksheet_host.env (not committed with secrets) or
# /etc/worksheet_host.env and point EnvironmentFile= at it.
#
# RAILS_ENV=production
# RAILS_MASTER_KEY=...
# WORKSHEET_HOST_DATA_ROOT=/mnt/raid1/data/worksheet_host
# PORT=3000
# PUMA_BIND=0.0.0.0
# RAILS_MAX_THREADS=3
# FORCE_SSL=false
# WORKSHEET_INTAKE_SCAN_INTERVAL=45
# # Optional absolute SQLite path override:
# # DATABASE_PATH=/mnt/raid1/data/worksheet_host/db/production.sqlite3

RAILS_ENV=production
WORKSHEET_HOST_DATA_ROOT=/mnt/raid1/data/worksheet_host
PORT=3000
PUMA_BIND=0.0.0.0
RAILS_MAX_THREADS=3
FORCE_SSL=false
WORKSHEET_INTAKE_SCAN_INTERVAL=45
